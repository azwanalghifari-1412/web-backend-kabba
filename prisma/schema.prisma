datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// 1. Tabel Admin / Pengelola Desa
model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  nama      String
  role      String   @default("admin")
  createdAt DateTime @default(now())
}

// 2. Tabel Berita & Pengumuman
model Berita {
  id        String   @id @default(uuid())
  judul     String
  slug      String   @unique
  konten    String   @db.Text
  kategori  String   // Misal: "Pengumuman", "Kegiatan", "Kesehatan"
  gambarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 3. Tabel Data Demografi (Untuk Grafik Chart.js)
model Demografi {
  id       String @id @default(uuid())
  kategori String // Misal: "usia", "pekerjaan", "pendidikan"
  label    String // Misal: "Petani", "0-14 Thn"
  jumlah   Int
}

// 4. Tabel UMKM / Pasar Kabba
model Umkm {
  id          String   @id @default(uuid())
  namaProduk  String
  namaPemilik String
  deskripsi   String?  @db.Text
  harga       Float
  kontenWa    String   // Nomor WhatsApp Penjual
  gambarUrl   String?
  createdAt   DateTime @default(now())
}

// 5. Tabel Destinasi Wisata & Galeri
model Wisata {
  id        String   @id @default(uuid())
  namaSpot  String
  deskripsi String   @db.Text
  lokasi    String?  // Link Google Maps
  gambarUrl String?
  createdAt DateTime @default(now())
}

// 6. Tabel Aparatur & Struktur Organisasi Desa
model Aparatur {
  id      String @id @default(uuid())
  nama    String
  jabatan String
  fotoUrl String?
  urutan  Int    @default(0)
}